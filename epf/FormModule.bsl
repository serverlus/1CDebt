// ============================================================
// ВНЕШНЯЯ ОБРАБОТКА: Умная Дебиторка v1.0.0
// Модуль формы — всё в одном файле
//
// Реквизиты формы (создать вручную перед вставкой кода):
//   ДатаАнализа       — Дата
//   ТаблицаСкоринга   — ТаблицаЗначений (колонки ниже)
//   ТекстРасшифровки  — Строка (многострочное поле, 7 строк)
//
// Колонки ТаблицаСкоринга:
//   Контрагент                — СправочникСсылка.Контрагенты
//   НаименованиеКонтрагента   — Строка(500)
//   ИНН                       — Строка(12)
//   СуммаДолга                — Число(18,2)
//   СуммаПросрочки            — Число(18,2)
//   МаксДнейПросрочки         — Число(5,0)
//   Балл                      — Число(3,0)
//   Категория                 — Строка(1)
// ============================================================

// ── Инициализация ─────────────────────────────────────────────

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ДатаАнализа = ТекущаяДата();
	ОбновитьТаблицуСкоринга();
КонецПроцедуры

// ── Команды формы ─────────────────────────────────────────────

&НаКлиенте
Процедура КомандаОбновить(Команда)
	ОбновитьТаблицуСкоринга();
КонецПроцедуры

&НаКлиенте
Процедура КомандаВыгрузитьExcel(Команда)
	ВыгрузитьВExcelНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаСкорингаПриАктивизацииСтроки(Элемент)
	ОбновитьРасшифровкуНаСервере();
КонецПроцедуры

// ── Серверные процедуры (UI) ──────────────────────────────────

&НаСервере
Процедура ОбновитьТаблицуСкоринга()

	ТаблицаСкоринга.Очистить();

	РезультатСкоринга = ПолучитьСкорингВсехКонтрагентов(ДатаАнализа);

	Для Каждого Строка Из РезультатСкоринга Цикл
		НовСтр = ТаблицаСкоринга.Добавить();
		НовСтр.Контрагент              = Строка.Контрагент;
		НовСтр.НаименованиеКонтрагента = Строка.НаименованиеКонтрагента;
		НовСтр.ИНН                     = Строка.ИНН;
		НовСтр.СуммаДолга              = Строка.СуммаДолга;
		НовСтр.СуммаПросрочки          = Строка.СуммаПросрочки;
		НовСтр.МаксДнейПросрочки       = Строка.МаксДнейПросрочки;
		НовСтр.Балл                    = Строка.Балл;
		НовСтр.Категория               = Строка.Категория;
	КонецЦикла;

	ТекстРасшифровки = "";
	НастроитьУсловноеОформление();

КонецПроцедуры

&НаСервере
Процедура НастроитьУсловноеОформление()

	УсловноеОформление.Элементы.Очистить();

	МассивКатегорий = Новый Массив;
	МассивКатегорий.Добавить(Новый Структура("Категория, Кр, Зел, Синий", "D", 255, 200, 200));
	МассивКатегорий.Добавить(Новый Структура("Категория, Кр, Зел, Синий", "C", 255, 220, 150));
	МассивКатегорий.Добавить(Новый Структура("Категория, Кр, Зел, Синий", "B", 255, 255, 180));
	МассивКатегорий.Добавить(Новый Структура("Категория, Кр, Зел, Синий", "A", 200, 255, 200));

	Для Каждого Эл Из МассивКатегорий Цикл
		ЭлОф = УсловноеОформление.Элементы.Добавить();
		ЭлОф.Оформление.УстановитьЗначениеПараметра("ЦветФона",
			Новый Цвет(Эл.Кр, Эл.Зел, Эл.Синий));
		ОтбЭл = ЭлОф.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ОтбЭл.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("Категория");
		ОтбЭл.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
		ОтбЭл.ПравоеЗначение = Эл.Категория;
		ЭлОф.Поля.Элементы.Добавить().Поле =
			Новый ПолеКомпоновкиДанных("НаименованиеКонтрагента");
		ЭлОф.Поля.Элементы.Добавить().Поле =
			Новый ПолеКомпоновкиДанных("Балл");
		ЭлОф.Поля.Элементы.Добавить().Поле =
			Новый ПолеКомпоновкиДанных("Категория");
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ОбновитьРасшифровкуНаСервере()

	ТекущаяСтрока = Элементы.ТаблицаСкоринга.ТекущиеДанные;
	Если ТекущаяСтрока = Неопределено
		ИЛИ НЕ ЗначениеЗаполнено(ТекущаяСтрока.Контрагент) Тогда
		ТекстРасшифровки = "";
		Возврат;
	КонецЕсли;

	Скоринг = РассчитатьСкоринг(ТекущаяСтрока.Контрагент, ДатаАнализа);
	ТекстРасшифровки = СформироватьТекстРасшифровки(Скоринг);

КонецПроцедуры

&НаСервере
Процедура ВыгрузитьВExcelНаСервере()

	ТабДок = Новый ТабличныйДокумент;
	ТабДок.Область("R1C1").Текст = "Умная дебиторка — Скоринг контрагентов";
	ТабДок.Область("R1C1").Шрифт = Новый Шрифт(, 14, Истина);
	ТабДок.Область("R2C1").Текст =
		"Дата анализа: " + Формат(ДатаАнализа, "ДФ=dd.MM.yyyy");

	Заголовки = СтрРазделить(
		"Контрагент|ИНН|Долг руб.|Просрочка руб.|Макс.дней|Балл|Категория",
		"|");

	Для НомерКол = 1 По Заголовки.Количество() Цикл
		Обл = ТабДок.Область(4, НомерКол);
		Обл.Текст    = Заголовки[НомерКол - 1];
		Обл.Шрифт   = Новый Шрифт(, , Истина);
		Обл.ЦветФона = Новый Цвет(200, 200, 200);
	КонецЦикла;

	НомСтр = 5;
	Для Каждого Строка Из ТаблицаСкоринга Цикл
		ТабДок.Область(НомСтр, 1).Текст = Строка.НаименованиеКонтрагента;
		ТабДок.Область(НомСтр, 2).Текст = Строка.ИНН;
		ТабДок.Область(НомСтр, 3).Текст = Строка.СуммаДолга;
		ТабДок.Область(НомСтр, 4).Текст = Строка.СуммаПросрочки;
		ТабДок.Область(НомСтр, 5).Текст = Строка.МаксДнейПросрочки;
		ТабДок.Область(НомСтр, 6).Текст = Строка.Балл;
		ТабДок.Область(НомСтр, 7).Текст = Строка.Категория;
		ЦветФона = ЦветФонаПоКатегории(Строка.Категория);
		ТабДок.Область(НомСтр, 6).ЦветФона = ЦветФона;
		ТабДок.Область(НомСтр, 7).ЦветФона = ЦветФона;
		НомСтр = НомСтр + 1;
	КонецЦикла;

	ТабДок.Показать("Умная дебиторка");

КонецПроцедуры

// ── Скоринговый движок ────────────────────────────────────────

&НаСервере
Функция ПолучитьСкорингВсехКонтрагентов(ДатаАнализа)

	ТЗ = Новый ТаблицаЗначений;
	ТЗ.Колонки.Добавить("Контрагент");
	ТЗ.Колонки.Добавить("НаименованиеКонтрагента");
	ТЗ.Колонки.Добавить("ИНН");
	ТЗ.Колонки.Добавить("СуммаДолга");
	ТЗ.Колонки.Добавить("СуммаПросрочки");
	ТЗ.Колонки.Добавить("МаксДнейПросрочки");
	ТЗ.Колонки.Добавить("Балл");
	ТЗ.Колонки.Добавить("Категория");
	ТЗ.Колонки.Добавить("Цвет");

	// ── Запрос списка контрагентов с дебиторкой ──────────────
	// ВАЖНО: замените имя регистра под вашу конфигурацию:
	//   УТ 11 / КА 2   → ВзаиморасчетыСКонтрагентами
	//   Бухгалтерия 3  → РасчетыСКонтрагентами
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВзОст.Контрагент                                КАК Контрагент,
	|	СУММА(ВзОст.СуммаОстаток)                       КАК СуммаДолга,
	|	СУММА(ВЫБОР
	|		КОГДА ДОБАВИТЬКДАТЕ(РТУ.Дата, ДЕНЬ,
	|			ЕСТЬNULL(РТУ.СрокОплатыПоДоговору, 0)) < &ДатаАнализа
	|			ТОГДА ВзОст.СуммаОстаток
	|		ИНАЧЕ 0
	|	КОНЕЦ)                                           КАК СуммаПросрочки,
	|	МАКСИМУМ(ВЫБОР
	|		КОГДА ДОБАВИТЬКДАТЕ(РТУ.Дата, ДЕНЬ,
	|			ЕСТЬNULL(РТУ.СрокОплатыПоДоговору, 0)) < &ДатаАнализа
	|			ТОГДА РАЗНОСТЬДАТ(
	|				ДОБАВИТЬКДАТЕ(РТУ.Дата, ДЕНЬ,
	|					ЕСТЬNULL(РТУ.СрокОплатыПоДоговору, 0)),
	|				&ДатаАнализа, ДЕНЬ)
	|		ИНАЧЕ 0
	|	КОНЕЦ)                                           КАК МаксДнейПросрочки,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВЫБОР
	|		КОГДА ДОБАВИТЬКДАТЕ(РТУ.Дата, ДЕНЬ,
	|			ЕСТЬNULL(РТУ.СрокОплатыПоДоговору, 0)) < &ДатаАнализа
	|			ТОГДА ВзОст.Регистратор
	|		ИНАЧЕ NULL
	|	КОНЕЦ)                                           КАК КолПросроченных
	|ИЗ
	|	РегистрНакопления.ВзаиморасчетыСКонтрагентами.Остатки(
	|		&ДатаАнализа,
	|		СуммаОстаток > 0
	|	) КАК ВзОст
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг КАК РТУ
	|		ПО ВзОст.Регистратор = РТУ.Ссылка
	|СГРУППИРОВАТЬ ПО
	|	ВзОст.Контрагент
	|ИМЕЮЩИЕ
	|	СУММА(ВзОст.СуммаОстаток) > 0
	|УПОРЯДОЧИТЬ ПО
	|	СуммаДолга УБЫВ";

	Запрос.УстановитьПараметр("ДатаАнализа", КонецДня(ДатаАнализа));

	РезЗапроса = Запрос.Выполнить();
	Если РезЗапроса.Пустой() Тогда
		Возврат ТЗ;
	КонецЕсли;

	Выборка = РезЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл

		// Получаем историю платежей отдельным запросом
		ИсторияПлатежей = ПолучитьИсториюПлатежей(Выборка.Контрагент, ДатаАнализа);

		// Рассчитываем балл
		Балл = 100;
		Балл = Балл - ШтрафДнейПросрочки(Выборка.МаксДнейПросрочки);
		Балл = Балл - ШтрафДолиПросрочки(Выборка.СуммаПросрочки, Выборка.СуммаДолга);
		Балл = Балл - ШтрафИсторииПлатежей(ИсторияПлатежей);
		Балл = Балл - ШтрафКолПросроченных(Выборка.КолПросроченных);
		Балл = Макс(0, Мин(100, Балл));

		Категория = ОпределитьКатегорию(Балл);

		Строка = ТЗ.Добавить();
		Строка.Контрагент              = Выборка.Контрагент;
		Строка.НаименованиеКонтрагента = Выборка.Контрагент.Наименование;
		Строка.ИНН                     = Выборка.Контрагент.ИНН;
		Строка.СуммаДолга              = ?(Выборка.СуммаДолга       = NULL, 0, Выборка.СуммаДолга);
		Строка.СуммаПросрочки          = ?(Выборка.СуммаПросрочки   = NULL, 0, Выборка.СуммаПросрочки);
		Строка.МаксДнейПросрочки       = ?(Выборка.МаксДнейПросрочки = NULL, 0, Выборка.МаксДнейПросрочки);
		Строка.Балл                    = Балл;
		Строка.Категория               = Категория;
		Строка.Цвет                    = ЦветКатегории(Категория);

	КонецЦикла;

	ТЗ.Сортировать("Балл Возр, СуммаПросрочки Убыв");
	Возврат ТЗ;

КонецФункции

&НаСервере
Функция РассчитатьСкоринг(Контрагент, ДатаАнализа)

	// Данные о текущей дебиторке
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СУММА(ВзОст.СуммаОстаток)                       КАК СуммаДолга,
	|	СУММА(ВЫБОР
	|		КОГДА ДОБАВИТЬКДАТЕ(РТУ.Дата, ДЕНЬ,
	|			ЕСТЬNULL(РТУ.СрокОплатыПоДоговору, 0)) < &ДатаАнализа
	|			ТОГДА ВзОст.СуммаОстаток
	|		ИНАЧЕ 0
	|	КОНЕЦ)                                           КАК СуммаПросрочки,
	|	МАКСИМУМ(ВЫБОР
	|		КОГДА ДОБАВИТЬКДАТЕ(РТУ.Дата, ДЕНЬ,
	|			ЕСТЬNULL(РТУ.СрокОплатыПоДоговору, 0)) < &ДатаАнализа
	|			ТОГДА РАЗНОСТЬДАТ(
	|				ДОБАВИТЬКДАТЕ(РТУ.Дата, ДЕНЬ,
	|					ЕСТЬNULL(РТУ.СрокОплатыПоДоговору, 0)),
	|				&ДатаАнализа, ДЕНЬ)
	|		ИНАЧЕ 0
	|	КОНЕЦ)                                           КАК МаксДнейПросрочки,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВЫБОР
	|		КОГДА ДОБАВИТЬКДАТЕ(РТУ.Дата, ДЕНЬ,
	|			ЕСТЬNULL(РТУ.СрокОплатыПоДоговору, 0)) < &ДатаАнализа
	|			ТОГДА ВзОст.Регистратор
	|		ИНАЧЕ NULL
	|	КОНЕЦ)                                           КАК КолПросроченных
	|ИЗ
	|	РегистрНакопления.ВзаиморасчетыСКонтрагентами.Остатки(
	|		&ДатаАнализа,
	|		Контрагент = &Контрагент И СуммаОстаток > 0
	|	) КАК ВзОст
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг КАК РТУ
	|		ПО ВзОст.Регистратор = РТУ.Ссылка";

	Запрос.УстановитьПараметр("Контрагент",  Контрагент);
	Запрос.УстановитьПараметр("ДатаАнализа", КонецДня(ДатаАнализа));

	СуммаДолга        = 0;
	СуммаПросрочки    = 0;
	МаксДней          = 0;
	КолПросроченных   = 0;

	РезЗапроса = Запрос.Выполнить();
	Если НЕ РезЗапроса.Пустой() Тогда
		Выб = РезЗапроса.Выбрать();
		Если Выб.Следующий() Тогда
			СуммаДолга      = ?(Выб.СуммаДолга       = NULL, 0, Выб.СуммаДолга);
			СуммаПросрочки  = ?(Выб.СуммаПросрочки   = NULL, 0, Выб.СуммаПросрочки);
			МаксДней        = ?(Выб.МаксДнейПросрочки = NULL, 0, Выб.МаксДнейПросрочки);
			КолПросроченных = ?(Выб.КолПросроченных   = NULL, 0, Выб.КолПросроченных);
		КонецЕсли;
	КонецЕсли;

	ИсторияПлатежей = ПолучитьИсториюПлатежей(Контрагент, ДатаАнализа);

	// Расшифровка по факторам
	Расшифровка = Новый ТаблицаЗначений;
	Расшифровка.Колонки.Добавить("Фактор");
	Расшифровка.Колонки.Добавить("Значение");
	Расшифровка.Колонки.Добавить("Штраф");

	Балл = 100;

	Ш1 = ШтрафДнейПросрочки(МаксДней);
	Балл = Балл - Ш1;
	Стр = Расшифровка.Добавить();
	Стр.Фактор  = "Макс. просрочка (вес 30%)";
	Стр.Значение = Формат(МаксДней, "ЧЦ=5; ЧН=0") + " дн.";
	Стр.Штраф   = -Ш1;

	Ш2 = ШтрафДолиПросрочки(СуммаПросрочки, СуммаДолга);
	Балл = Балл - Ш2;
	ДоляПросрочки = ?(СуммаДолга > 0, СуммаПросрочки / СуммаДолга * 100, 0);
	Стр = Расшифровка.Добавить();
	Стр.Фактор  = "Доля просрочки (вес 35%)";
	Стр.Значение = Формат(ДоляПросрочки, "ЧЦ=5; ЧДЦ=1; ЧН=0") + "%  ("
		+ Формат(СуммаПросрочки, "ЧЦ=15; ЧГ=3; ЧН=0") + " руб.)";
	Стр.Штраф   = -Ш2;

	Ш3 = ШтрафИсторииПлатежей(ИсторияПлатежей);
	Балл = Балл - Ш3;
	Стр = Расшифровка.Добавить();
	Стр.Фактор  = "История платежей 12 мес (вес 25%)";
	Стр.Значение = Формат(ИсторияПлатежей.ПроцентПросроченных, "ЧЦ=5; ЧДЦ=1; ЧН=0")
		+ "% просрочено  ("
		+ Формат(ИсторияПлатежей.КолПросроченных,   "ЧЦ=3; ЧН=0")
		+ " из "
		+ Формат(ИсторияПлатежей.ВсегоДокументов, "ЧЦ=3; ЧН=0") + " оплат)";
	Стр.Штраф   = -Ш3;

	Ш4 = ШтрафКолПросроченных(КолПросроченных);
	Балл = Балл - Ш4;
	Стр = Расшифровка.Добавить();
	Стр.Фактор  = "Кол-во просрочен. документов (вес 10%)";
	Стр.Значение = Формат(КолПросроченных, "ЧЦ=3; ЧН=0") + " шт.";
	Стр.Штраф   = -Ш4;

	Балл = Макс(0, Мин(100, Балл));
	Категория = ОпределитьКатегорию(Балл);

	Скоринг = Новый Структура;
	Скоринг.Вставить("Балл",        Балл);
	Скоринг.Вставить("Категория",   Категория);
	Скоринг.Вставить("Цвет",        ЦветКатегории(Категория));
	Скоринг.Вставить("Расшифровка", Расшифровка);

	Возврат Скоринг;

КонецФункции

&НаСервере
Функция ПолучитьИсториюПлатежей(Контрагент, ДатаАнализа)

	ДатаНачала = ДобавитьМесяц(НачалоДня(ДатаАнализа), -12);

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(ВзОб.Регистратор)         КАК ВсегоДокументов,
	|	СУММА(ВЫБОР
	|		КОГДА ВзОб.Период > ДОБАВИТЬКДАТЕ(РТУ.Дата, ДЕНЬ,
	|			ЕСТЬNULL(РТУ.СрокОплатыПоДоговору, 0))
	|			ТОГДА 1
	|		ИНАЧЕ 0
	|	КОНЕЦ)                               КАК КолПросроченных
	|ИЗ
	|	РегистрНакопления.ВзаиморасчетыСКонтрагентами.Обороты(
	|		&ДатаНачала, &ДатаАнализа, ,
	|		Контрагент = &Контрагент И СуммаРасход > 0
	|	) КАК ВзОб
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг КАК РТУ
	|		ПО ВзОб.Регистратор = РТУ.Ссылка";

	Запрос.УстановитьПараметр("Контрагент",  Контрагент);
	Запрос.УстановитьПараметр("ДатаНачала",  ДатаНачала);
	Запрос.УстановитьПараметр("ДатаАнализа", КонецДня(ДатаАнализа));

	История = Новый Структура(
		"ВсегоДокументов, КолПросроченных, ПроцентПросроченных", 0, 0, 0);

	РезЗапроса = Запрос.Выполнить();
	Если НЕ РезЗапроса.Пустой() Тогда
		Выб = РезЗапроса.Выбрать();
		Если Выб.Следующий() Тогда
			История.ВсегоДокументов  = ?(Выб.ВсегоДокументов  = NULL, 0, Выб.ВсегоДокументов);
			История.КолПросроченных  = ?(Выб.КолПросроченных  = NULL, 0, Выб.КолПросроченных);
			Если История.ВсегоДокументов > 0 Тогда
				История.ПроцентПросроченных =
					История.КолПросроченных / История.ВсегоДокументов * 100;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	Возврат История;

КонецФункции

// ── Факторы скоринга ──────────────────────────────────────────

&НаСервере
Функция ШтрафДнейПросрочки(Дней)
	Если    Дней > 90 Тогда Возврат 30;
	ИначеЕсли Дней > 60 Тогда Возврат 20;
	ИначеЕсли Дней > 30 Тогда Возврат 12;
	ИначеЕсли Дней > 14 Тогда Возврат 6;
	ИначеЕсли Дней > 7  Тогда Возврат 3;
	Иначе                      Возврат 0;
	КонецЕсли;
КонецФункции

&НаСервере
Функция ШтрафДолиПросрочки(СуммаПросрочки, СуммаДолга)
	Доля = ?(СуммаДолга > 0, СуммаПросрочки / СуммаДолга * 100, 0);
	Если    Доля >= 90 Тогда Возврат 35;
	ИначеЕсли Доля >= 70 Тогда Возврат 25;
	ИначеЕсли Доля >= 50 Тогда Возврат 15;
	ИначеЕсли Доля >= 30 Тогда Возврат 8;
	ИначеЕсли Доля >= 10 Тогда Возврат 3;
	Иначе                       Возврат 0;
	КонецЕсли;
КонецФункции

&НаСервере
Функция ШтрафИсторииПлатежей(История)
	Процент = История.ПроцентПросроченных;
	Если    Процент >= 50 Тогда Возврат 25;
	ИначеЕсли Процент >= 30 Тогда Возврат 15;
	ИначеЕсли Процент >= 15 Тогда Возврат 8;
	ИначеЕсли Процент >= 5  Тогда Возврат 3;
	Иначе                          Возврат 0;
	КонецЕсли;
КонецФункции

&НаСервере
Функция ШтрафКолПросроченных(Кол)
	Если    Кол >= 5 Тогда Возврат 10;
	ИначеЕсли Кол >= 3 Тогда Возврат 6;
	ИначеЕсли Кол >= 1 Тогда Возврат 3;
	Иначе                     Возврат 0;
	КонецЕсли;
КонецФункции

// ── Вспомогательные ───────────────────────────────────────────

&НаСервере
Функция ОпределитьКатегорию(Балл)
	Если    Балл >= 80 Тогда Возврат "A";
	ИначеЕсли Балл >= 60 Тогда Возврат "B";
	ИначеЕсли Балл >= 40 Тогда Возврат "C";
	Иначе                       Возврат "D";
	КонецЕсли;
КонецФункции

&НаСервере
Функция ЦветКатегории(Категория)
	Если    Категория = "A" Тогда Возврат "Зелёный";
	ИначеЕсли Категория = "B" Тогда Возврат "Жёлтый";
	ИначеЕсли Категория = "C" Тогда Возврат "Оранжевый";
	Иначе                           Возврат "Красный";
	КонецЕсли;
КонецФункции

&НаСервере
Функция ЦветФонаПоКатегории(Категория)
	Если    Категория = "A" Тогда Возврат Новый Цвет(200, 255, 200);
	ИначеЕсли Категория = "B" Тогда Возврат Новый Цвет(255, 255, 180);
	ИначеЕсли Категория = "C" Тогда Возврат Новый Цвет(255, 220, 150);
	Иначе                           Возврат Новый Цвет(255, 200, 200);
	КонецЕсли;
КонецФункции

&НаСервере
Функция СформироватьТекстРасшифровки(Скоринг)

	Текст = "";
	Для Каждого Стр Из Скоринг.Расшифровка Цикл
		ЗнакШтрафа = ?(Стр.Штраф < 0, "", "+");
		Текст = Текст
			+ "[" + Стр.Фактор + "]" + Символы.ПС
			+ "   " + Стр.Значение
			+ "  →  " + ЗнакШтрафа + Формат(Стр.Штраф, "ЧЦ=4; ЧН=0") + " б." + Символы.ПС;
	КонецЦикла;

	Текст = Текст
		+ "─────────────────────────────────────" + Символы.ПС
		+ "ИТОГ: " + Скоринг.Балл + " баллов  |  "
		+ "Категория " + Скоринг.Категория
		+ "  (" + Скоринг.Цвет + ")";

	Возврат Текст;

КонецФункции
