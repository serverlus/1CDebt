// ============================================================
// ДС_Лицензия.bsl
// Общий модуль расширения 1С (серверный)
//
// Всё управление лицензиями на стороне 1С:
//   — Вызов активации через компоненту
//   — Кэш валидности (проверяем не чаще раза в час)
//   — Отображение статуса в интерфейсе
// ============================================================

#Область ПрограммныйИнтерфейс

// Возвращает Истина если лицензия действительна
// Кэшируем результат на 1 час — не дёргаем компоненту на каждом вызове
Функция ЛицензияДействительна() Экспорт

	КэшВалидности = ПолучитьИзВременногоХранилища("ДС_КэшЛицензии");

	Если КэшВалидности <> Неопределено Тогда
		Если КэшВалидности.ВремяПроверки > ТекущаяДата() - 3600 Тогда
			Возврат КэшВалидности.Действительна;
		КонецЕсли;
	КонецЕсли;

	// Проверяем через компоненту
	Действительна = ПроверитьЧерезКомпоненту();

	// Кэшируем
	НовыйКэш = Новый Структура("Действительна,ВремяПроверки",
		Действительна, ТекущаяДата());
	ПоместитьВоВременноеХранилище(НовыйКэш, "ДС_КэшЛицензии");

	Возврат Действительна;

КонецФункции

// Активация лицензионного ключа
// Вызывается из формы мастера установки
Функция АктивироватьКлюч(ЛицензионныйКлюч) Экспорт

	Попытка
		ПодключитьВнешнююКомпоненту(
			"ОбщийМакет.ДС_КомпонентаСкоринга",
			"ДС_Scoring",
			ТипВнешнейКомпоненты.Native
		);
		Компонента = Новый("AddIn.ДС_Scoring.DebtScoringAddIn");

		ИНН        = Константы.ИННОрганизации.Получить();
		МАС        = "";  // компонента определит сама

		РезультатJSON = Компонента.ActivateLicense(ЛицензионныйКлюч, ИНН, МАС);

		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(РезультатJSON);
		Результат  = ПрочитатьJSON(ЧтениеJSON);

		Если Результат.Success = Истина Тогда
			// Сбрасываем кэш — лицензия только что стала валидной
			УдалитьИзВременногоХранилища("ДС_КэшЛицензии");
			Возврат Новый Структура("Успех,Сообщение,ДоKогда,Тариф",
				Истина,
				"Лицензия успешно активирована!",
				Результат.ExpiresAt,
				Результат.Plan
			);
		Иначе
			Возврат Новый Структура("Успех,Сообщение",
				Ложь, Результат.Info);
		КонецЕсли;

	Исключение
		Возврат Новый Структура("Успех,Сообщение",
			Ложь, "Ошибка активации: " + ОписаниеОшибки());
	КонецПопытки;

КонецФункции

// Получить информацию о текущей лицензии для отображения в интерфейсе
Функция ПолучитьИнформациюОЛицензии() Экспорт

	Попытка
		ПодключитьВнешнююКомпоненту(
			"ОбщийМакет.ДС_КомпонентаСкоринга",
			"ДС_Scoring",
			ТипВнешнейКомпоненты.Native
		);
		Компонента    = Новый("AddIn.ДС_Scoring.DebtScoringAddIn");
		ВерсияJSON    = Компонента.GetVersion();

		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(ВерсияJSON);
		Возврат ПрочитатьJSON(ЧтениеJSON);

	Исключение
		Возврат Новый Структура("error", ОписаниеОшибки());
	КонецПопытки;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПроверитьЧерезКомпоненту()
	Попытка
		ПодключитьВнешнююКомпоненту(
			"ОбщийМакет.ДС_КомпонентаСкоринга",
			"ДС_Scoring",
			ТипВнешнейКомпоненты.Native
		);
		Компонента = Новый("AddIn.ДС_Scoring.DebtScoringAddIn");
		Возврат Компонента.CheckLicense();
	Исключение
		Возврат Ложь;
	КонецПопытки;
КонецФункции

#КонецОбласти
