// ============================================================
// ДС_АктивацияЛицензии — Форма обработки (мастер установки)
// ============================================================
// Клиент открывает эту форму при первом запуске и вводит ключ.
// После активации форма больше не показывается.
//
// Реквизиты формы (создать в конфигураторе):
//   ЛицензионныйКлюч    — Строка(29)
//   СтатусАктивации     — Строка
//   ТарифПодписки       — Строка
//   ДатаОкончания       — Строка
//   ИНН                 — Строка (заполняется автоматически)
//   МАС                 — Строка (заполняется автоматически)
// ============================================================

#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура ПриОткрытии(Отказ)
    // Заполняем информацию о текущей установке
    ЗаполнитьИнформациюОбУстановке();

    // Проверяем — вдруг уже активировано
    Если ДС_Лицензия.ЛицензияДействительна() Тогда
        ПоказатьТекущуюЛицензию();
    КонецЕсли;
КонецПроцедуры

#КонецОбласти

// ── Заполнение информации ───────────────────────────────────

&НаКлиенте
Процедура ЗаполнитьИнформациюОбУстановке()
    СтруктураИнфо = ПолучитьИнформациюОбУстановкеНаСервере();
    ИНН = СтруктураИнфо.ИНН;
    МАС = СтруктураИнфо.МАС;
КонецПроцедуры

&НаСервере
Функция ПолучитьИнформациюОбУстановкеНаСервере()
    Результат = Новый Структура("ИНН,МАС", "", "");
    Попытка
        Результат.ИНН = Константы.ИННОрганизации.Получить();
    Исключение
    КонецПопытки;
    Возврат Результат;
КонецФункции

// ── Активация ──────────────────────────────────────────────

&НаКлиенте
Процедура АктивироватьЛицензию(Команда)
    Ключ = СокрЛП(ЛицензионныйКлюч);

    // Базовая валидация формата
    Если НЕ КлючВерногоФормата(Ключ) Тогда
        ПоказатьПредупреждение(,
            "Неверный формат ключа." + Символы.ПС +
            "Ожидается: DSCR-XXXX-XXXX-XXXX-XXXX");
        Возврат;
    КонецЕсли;

    Состояние("⏳ Активируем лицензию...");
    Результат = АктивироватьНаСервере(Ключ);
    Состояние();

    Если Результат.Успех Тогда
        ТарифПодписки  = Результат.Тариф;
        ДатаОкончания  = Результат.ДоКогда;
        СтатусАктивации = "✅ Лицензия активирована!";
        Элементы.СтатусАктивации.ЦветТекста = ВебЦвета.Зелёный;

        ПоказатьОповещениеПользователя(
            "🎉 Активация прошла успешно!",
            ,
            "Тариф: " + ТарифПодписки + Символы.ПС +
            "Действует до: " + ДатаОкончания,
            КартинкаСтатусаПроверкиДостоверности.Успех
        );

        // Показываем кнопку "Открыть анализ дебиторки"
        Элементы.КнопкаОткрытьАнализ.Видимость = Истина;

    Иначе
        СтатусАктивации = "❌ " + Результат.Сообщение;
        Элементы.СтатусАктивации.ЦветТекста = ВебЦвета.Красный;
    КонецЕсли;
КонецПроцедуры

&НаСервере
Функция АктивироватьНаСервере(ЛицензионныйКлюч)
    Результат = ДС_Лицензия.АктивироватьКлюч(ЛицензионныйКлюч);

    Ответ = Новый Структура("Успех,Сообщение,Тариф,ДоКогда", Ложь, "", "", "");
    Ответ.Успех    = Результат.Успех;
    Ответ.Сообщение = ?(Результат.Свойство("Сообщение"), Результат.Сообщение, "");

    Если Результат.Успех Тогда
        Ответ.Тариф   = ?(Результат.Свойство("Тариф"),   Результат.Тариф, "");
        Ответ.ДоКогда = ?(Результат.Свойство("ДоKогда"), Результат.ДоКогда, "");
    КонецЕсли;

    Возврат Ответ;
КонецФункции

// ── Показ текущей лицензии (уже активирована) ──────────────

&НаКлиенте
Процедура ПоказатьТекущуюЛицензию()
    Инфо = ПолучитьИнформациюОЛицензии();

    СтатусАктивации = "✅ Лицензия активна";
    Если ТипЗнч(Инфо) = Тип("Структура") Тогда
        Если Инфо.Свойство("plan") Тогда
            ТарифПодписки = Инфо.plan;
        КонецЕсли;
    КонецЕсли;

    Элементы.СтатусАктивации.ЦветТекста = ВебЦвета.Зелёный;
    Элементы.КнопкаОткрытьАнализ.Видимость = Истина;
КонецПроцедуры

&НаСервере
Функция ПолучитьИнформациюОЛицензии()
    Возврат ДС_Лицензия.ПолучитьИнформациюОЛицензии();
КонецФункции

// ── Переход к анализу ──────────────────────────────────────

&НаКлиенте
Процедура ОткрытьАнализДебиторки(Команда)
    // Открываем главный дашборд
    ОткрытьФорму("Обработка.ДС_АнализДебиторки.Форма",
        , , , , , , РежимОткрытияОкнаФормы.БезЗакрытияТекущего);
    Закрыть();
КонецПроцедуры

// ── Форматирование ключа при вводе ─────────────────────────

&НаКлиенте
Процедура ЛицензионныйКлючПриИзменении(Элемент)
    // Автоматически добавляем дефисы при вводе
    Ключ = ВерхРег(СокрЛП(ЛицензионныйКлюч));
    Ключ = СтрЗаменить(Ключ, " ", "");
    Ключ = СтрЗаменить(Ключ, "-", "");

    // Формируем DSCR-XXXX-XXXX-XXXX-XXXX
    Если СтрДлина(Ключ) > 4  Тогда Ключ = Лев(Ключ, 4)  + "-" + Сред(Ключ, 5); КонецЕсли;
    Если СтрДлина(Ключ) > 9  Тогда Ключ = Лев(Ключ, 9)  + "-" + Сред(Ключ, 10); КонецЕсли;
    Если СтрДлина(Ключ) > 14 Тогда Ключ = Лев(Ключ, 14) + "-" + Сред(Ключ, 15); КонецЕсли;
    Если СтрДлина(Ключ) > 19 Тогда Ключ = Лев(Ключ, 19) + "-" + Сред(Ключ, 20); КонецЕсли;

    ЛицензионныйКлюч = Лев(Ключ, 24); // Максимум 24 символа с дефисами
КонецПроцедуры

// ── Вспомогательные ────────────────────────────────────────

&НаКлиенте
Функция КлючВерногоФормата(Ключ)
    Части = СтрРазделить(Ключ, "-");
    Если Части.Количество() <> 5 Тогда Возврат Ложь; КонецЕсли;
    Если Части[0] <> "DSCR" Тогда Возврат Ложь; КонецЕсли;
    Для НомерЧасти = 1 По 4 Цикл
        Если СтрДлина(Части[НомерЧасти]) <> 4 Тогда Возврат Ложь; КонецЕсли;
    КонецЦикла;
    Возврат Истина;
КонецФункции
