#Область ПрограммныйИнтерфейс

// ----------------------------------------------------------
// РассчитатьСкоринг
// Основная функция. Возвращает структуру с результатом анализа.
//
// Параметры:
//   Контрагент  — ссылка на контрагента из справочника
//   ДатаНачала  — начало анализируемого периода (по умолч. -18 мес.)
//   ДатаОкончания — конец периода (по умолч. сегодня)
//
// Возвращает структуру:
//   .Скоринг              — число 0..100
//   .УровеньРиска         — строка: LOW / ACCEPTABLE / MEDIUM / HIGH / CRITICAL
//   .МеткаРиска           — строка: "Надёжный", "Высокий" и т.д.
//   .ЦветРиска            — строка: HEX цвет для оформления
//   .РекомендуемыйЛимит   — число, рекомендуемый кредитный лимит ₽
//   .РекомендуемаяОтсрочка — число дней
//   .РекомендацияТекст    — строка с рекомендацией менеджеру
//   .Алерты               — массив строк с предупреждениями
//   .Факторы              — структура с детализацией факторов
//   .Прогноз              — структура с прогнозом следующего платежа
//   .ИсходныеДанные       — сводка по периоду (кол-во счетов, суммы)
//   .Ошибка               — строка, если что-то пошло не так
// ----------------------------------------------------------
Функция РассчитатьСкоринг(Контрагент, ДатаНачала = Неопределено,
                           ДатаОкончания = Неопределено) Экспорт

	Результат = ПустойРезультат();

	// Значения по умолчанию
	Если ДатаНачала = Неопределено Тогда
		ДатаНачала = ДобавитьМесяц(НачалоДня(ТекущаяДата()), -18);
	КонецЕсли;
	Если ДатаОкончания = Неопределено Тогда
		ДатаОкончания = КонецДня(ТекущаяДата());
	КонецЕсли;

	// Проверка входных данных
	Если НЕ ЗначениеЗаполнено(Контрагент) Тогда
		Результат.Ошибка = "Не указан контрагент";
		Возврат Результат;
	КонецЕсли;

	// Проверка лицензии
	Если НЕ ДС_Лицензия.ЛицензияДействительна() Тогда
		Результат.Ошибка = "Лицензия недействительна. Обратитесь к администратору.";
		Возврат Результат;
	КонецЕсли;

	// Получаем историю платежей из 1С
	ИсторияПлатежей = ПолучитьИсториюПлатежей(Контрагент, ДатаНачала, ДатаОкончания);

	Если ИсторияПлатежей.Количество() = 0 Тогда
		Результат.Ошибка = "Нет данных о платежах за указанный период";
		Возврат Результат;
	КонецЕсли;

	// Формируем JSON для Python
	ЗапросJSON = СформироватьJSONЗапрос("score_single", ИсторияПлатежей);

	// Вызываем Python через компоненту
	РезультатJSON = ВызватьКомпоненту(ЗапросJSON);

	Если РезультатJSON = Неопределено Тогда
		Результат.Ошибка = "Ошибка вызова компоненты скоринга";
		Возврат Результат;
	КонецЕсли;

	// Парсим результат и заполняем структуру
	Возврат РазобратьРезультатСкоринга(РезультатJSON);

КонецФункции

// ----------------------------------------------------------
// АнализВсейДебиторки
// Рассчитывает скоринг для ВСЕХ контрагентов с активной дебиторкой.
// Один вызов Python для всех — быстро даже при 500+ контрагентах.
//
// Возвращает таблицу значений с колонками:
//   Контрагент, ТекущийДолг, Скоринг, УровеньРиска, МеткаРиска,
//   РекомендуемыйЛимит, РекомендуемаяОтсрочка, Алерты
// ----------------------------------------------------------
Функция АнализВсейДебиторки(ДатаНачала = Неопределено) Экспорт

	Если ДатаНачала = Неопределено Тогда
		ДатаНачала = ДобавитьМесяц(НачалоДня(ТекущаяДата()), -18);
	КонецЕсли;

	Если НЕ ДС_Лицензия.ЛицензияДействительна() Тогда
		Возврат Новый ТаблицаЗначений;
	КонецЕсли;

	// Получаем всех должников из регистра расчётов
	ТаблицаДолжников = ПолучитьВсехДолжников();

	Если ТаблицаДолжников.Количество() = 0 Тогда
		Возврат Новый ТаблицаЗначений;
	КонецЕсли;

	// Собираем истории платежей для всех контрагентов
	КонтрагентыJSON = Новый Структура;
	Для Каждого Строка Из ТаблицаДолжников Цикл
		ГУИД = Строка.Контрагент.УникальныйИдентификатор();
		ИсторияПлатежей = ПолучитьИсториюПлатежей(
			Строка.Контрагент, ДатаНачала, КонецДня(ТекущаяДата()));
		КонтрагентыJSON.Вставить(Строка(ГУИД), ИсторияПлатежей);
	КонецЦикла;

	// Один пакетный вызов Python
	ЗапросJSON    = СформироватьJSONЗапросПакетный(КонтрагентыJSON);
	РезультатJSON = ВызватьКомпоненту(ЗапросJSON);

	Если РезультатJSON = Неопределено Тогда
		Возврат Новый ТаблицаЗначений;
	КонецЕсли;

	// Собираем итоговую таблицу
	Возврат СобратьТаблицуРезультатов(РезультатJSON, ТаблицаДолжников);

КонецФункции

#КонецОбласти

// ============================================================
#Область СлужебныеПроцедурыИФункции
// ============================================================

// ----------------------------------------------------------
// Получение истории платежей из базы 1С
// Универсальный запрос — работает в УТ, КА, БП, ERP.
// Адаптируй под свою конфигурацию при необходимости.
// ----------------------------------------------------------
Функция ПолучитьИсториюПлатежей(Контрагент, ДатаНачала, ДатаОкончания)

	// Вариант 1: Конфигурации с регистром РасчётыСКонтрагентами (УТ, КА, ERP)
	Если ДС_СлужебныйМодуль.ДоступенРегистр("РасчётыСКонтрагентами") Тогда
		Возврат ПолучитьПлатежиИзРегистраРасчётов(Контрагент, ДатаНачала, ДатаОкончания);
	КонецЕсли;

	// Вариант 2: Конфигурации с документами счётов и оплат (БП, простые конфиги)
	Возврат ПолучитьПлатежиИзДокументов(Контрагент, ДатаНачала, ДатаОкончания);

КонецФункции

Функция ПолучитьПлатежиИзДокументов(Контрагент, ДатаНачала, ДатаОкончания)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Контрагент",    Контрагент);
	Запрос.УстановитьПараметр("ДатаНачала",    ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", ДатаОкончания);

	// Запрос работает в Бухгалтерии предприятия.
	// Для УТ/КА/ERP — замени имена документов и реквизитов.
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Счёт.Дата                             КАК ДатаСчёта,
	|	ДОБАВИТЬКДАТЕ(Счёт.Дата, ДЕНЬ, 30)    КАК ПлановаяДатаОплаты,
	|	Счёт.СуммаДокумента                   КАК Сумма,
	|	МАКСИМУМ(Оплата.Дата)                 КАК ФактическаяДатаОплаты,
	|	СУММА(ЕСТЬNULL(Оплата.СуммаДокумента, 0)) КАК ОплаченоСумма
	|ИЗ
	|	Документ.СчётНаОплатуПокупателю КАК Счёт
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПоступлениеНаРасчётныйСчёт КАК Оплата
	|		ПО Оплата.ДоговорКонтрагента = Счёт.ДоговорКонтрагента
	|			И Оплата.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
	|			И Оплата.Проведён
	|ГДЕ
	|	Счёт.Контрагент     = &Контрагент
	|	И Счёт.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
	|	И Счёт.Проведён
	|СГРУППИРОВАТЬ ПО
	|	Счёт.Дата,
	|	Счёт.СуммаДокумента
	|УПОРЯДОЧИТЬ ПО
	|	Счёт.Дата";

	Результат = Запрос.Выполнить().Выгрузить();
	Возврат ТаблицуВМассивПлатежей(Результат);

КонецФункции

Функция ТаблицуВМассивПлатежей(ТаблицаПлатежей)

	МассивПлатежей = Новый Массив;

	Для Каждого Строка Из ТаблицаПлатежей Цикл

		Платёж = Новый Структура;
		Платёж.Вставить("invoice_date", Формат(Строка.ДатаСчёта, "ДФ=yyyy-MM-dd"));
		Платёж.Вставить("due_date",     Формат(Строка.ПлановаяДатаОплаты, "ДФ=yyyy-MM-dd"));
		Платёж.Вставить("amount",       Строка.Сумма);
		Платёж.Вставить("paid_amount",  Строка.ОплаченоСумма);

		Если ЗначениеЗаполнено(Строка.ФактическаяДатаОплаты) Тогда
			Платёж.Вставить("payment_date",
				Формат(Строка.ФактическаяДатаОплаты, "ДФ=yyyy-MM-dd"));
		Иначе
			Платёж.Вставить("payment_date", Неопределено);
		КонецЕсли;

		МассивПлатежей.Добавить(Платёж);

	КонецЦикла;

	Возврат МассивПлатежей;

КонецФункции

Функция ПолучитьВсехДолжников()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Расчёты.Контрагент  КАК Контрагент,
	|	Расчёты.СуммаОстаток КАК ТекущийДолг
	|ИЗ
	|	РегистрНакопления.РасчётыСКонтрагентами.Остатки КАК Расчёты
	|ГДЕ
	|	Расчёты.СуммаОстаток > 0
	|УПОРЯДОЧИТЬ ПО
	|	ТекущийДолг УБЫВ";

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// ----------------------------------------------------------
// Вызов C# компоненты
// ----------------------------------------------------------
Функция ВызватьКомпоненту(ЗапросJSON)

	Попытка
		// Подключаем компоненту из макета расширения
		ПодключитьВнешнююКомпоненту(
			"ОбщийМакет.ДС_КомпонентаСкоринга",
			"ДС_Scoring",
			ТипВнешнейКомпоненты.Native
		);

		Компонента = Новый("AddIn.ДС_Scoring.DebtScoringAddIn");

		// Инициализация (Python + проверка лицензии внутри DLL)
		Если НЕ Компонента.Init() Тогда
			ДС_СлужебныйМодуль.ЗаписатьОшибку("Компонента: ошибка инициализации");
			Возврат Неопределено;
		КонецЕсли;

		РезультатJSON = Компонента.ScoreContractor(ЗапросJSON);
		Возврат РезультатJSON;

	Исключение
		ДС_СлужебныйМодуль.ЗаписатьОшибку("ВызватьКомпоненту: " + ОписаниеОшибки());
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

// ----------------------------------------------------------
// JSON — сериализация / десериализация
// ----------------------------------------------------------
Функция СформироватьJSONЗапрос(Действие, МассивПлатежей)

	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();

	НастройкиJSON = Новый НастройкиСериализацииJSON;
	НастройкиJSON.ФорматДатыJSON         = ФорматДатыJSON.ISO8601;
	НастройкиJSON.ВариантЗаписиДаты      = ВариантЗаписиДатыJSON.ДатаИВремя;

	ЗаписатьJSON(ЗаписьJSON, Новый Структура("action,payment_history",
		Действие, МассивПлатежей), НастройкиJSON);

	Возврат ЗаписьJSON.Закрыть();

КонецФункции

Функция СформироватьJSONЗапросПакетный(КонтрагентыСтруктура)

	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();

	ЗаписьJSON.ЗаписатьНачалоОбъекта();
	ЗаписьJSON.ЗаписатьИмяСвойства("action");
	ЗаписьJSON.ЗаписатьЗначение("score_batch");
	ЗаписьJSON.ЗаписатьИмяСвойства("contractors");
	ЗаписатьJSON(ЗаписьJSON, КонтрагентыСтруктура);
	ЗаписьJSON.ЗаписатьКонецОбъекта();

	Возврат ЗаписьJSON.Закрыть();

КонецФункции

Функция РазобратьРезультатСкоринга(РезультатJSON)

	Попытка
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(РезультатJSON);
		Данные = ПрочитатьJSON(ЧтениеJSON);
	Исключение
		Результат = ПустойРезультат();
		Результат.Ошибка = "Ошибка разбора ответа компоненты: " + ОписаниеОшибки();
		Возврат Результат;
	КонецПопытки;

	// Проверяем на ошибку от Python/компоненты
	Если Данные.Свойство("error") И ЗначениеЗаполнено(Данные.error) Тогда
		Результат = ПустойРезультат();
		Результат.Ошибка = Данные.error;
		Возврат Результат;
	КонецЕсли;

	// Заполняем структуру результата
	Результат = Новый Структура;
	Результат.Вставить("Скоринг",               Данные.score);
	Результат.Вставить("УровеньРиска",           Данные.risk_level);
	Результат.Вставить("МеткаРиска",             Данные.risk_label);
	Результат.Вставить("ЦветРиска",              Данные.risk_color);
	Результат.Вставить("РекомендуемыйЛимит",     Данные.recommended_credit_limit);
	Результат.Вставить("РекомендуемаяОтсрочка",  Данные.recommended_delay_days);
	Результат.Вставить("РекомендацияТекст",      Данные.recommended_action);
	Результат.Вставить("Алерты",                 Данные.alerts);
	Результат.Вставить("Факторы",                Данные.factors);
	Результат.Вставить("Прогноз",                Данные.forecast);
	Результат.Вставить("ИсходныеДанные",         Данные.summary);
	Результат.Вставить("Ошибка",                 "");

	Возврат Результат;

КонецФункции

Функция СобратьТаблицуРезультатов(РезультатJSON, ТаблицаДолжников)

	ТЗ = Новый ТаблицаЗначений;
	ТЗ.Колонки.Добавить("Контрагент");
	ТЗ.Колонки.Добавить("ТекущийДолг",          Новый ОписаниеТипов("Число"));
	ТЗ.Колонки.Добавить("Скоринг",              Новый ОписаниеТипов("Число"));
	ТЗ.Колонки.Добавить("УровеньРиска",         Новый ОписаниеТипов("Строка"));
	ТЗ.Колонки.Добавить("МеткаРиска",           Новый ОписаниеТипов("Строка"));
	ТЗ.Колонки.Добавить("ЦветРиска",            Новый ОписаниеТипов("Строка"));
	ТЗ.Колонки.Добавить("РекомендуемыйЛимит",   Новый ОписаниеТипов("Число"));
	ТЗ.Колонки.Добавить("РекомендуемаяОтсрочка",Новый ОписаниеТипов("Число"));
	ТЗ.Колонки.Добавить("РекомендацияТекст",    Новый ОписаниеТипов("Строка"));
	ТЗ.Колонки.Добавить("Алерты",               Новый ОписаниеТипов("Строка"));

	Попытка
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(РезультатJSON);
		ВсеРезультаты = ПрочитатьJSON(ЧтениеJSON); // Структура {GUID: {...}}
	Исключение
		Возврат ТЗ;
	КонецПопытки;

	Для Каждого Строка Из ТаблицаДолжников Цикл
		ГУИД = Строка(Строка.Контрагент.УникальныйИдентификатор());
		Если НЕ ВсеРезультаты.Свойство(ГУИД) Тогда
			Продолжить;
		КонецЕсли;

		Данные = ВсеРезультаты[ГУИД];
		НС = ТЗ.Добавить();
		НС.Контрагент             = Строка.Контрагент;
		НС.ТекущийДолг            = Строка.ТекущийДолг;
		НС.Скоринг                = Данные.score;
		НС.УровеньРиска           = Данные.risk_level;
		НС.МеткаРиска             = Данные.risk_label;
		НС.ЦветРиска              = Данные.risk_color;
		НС.РекомендуемыйЛимит     = Данные.recommended_credit_limit;
		НС.РекомендуемаяОтсрочка  = Данные.recommended_delay_days;
		НС.РекомендацияТекст      = Данные.recommended_action;

		// Алерты — объединяем в строку для отображения в таблице
		Если ТипЗнч(Данные.alerts) = Тип("Массив") Тогда
			НС.Алерты = СтрСоединить(Данные.alerts, "; ");
		КонецЕсли;

	КонецЦикла;

	// Сортируем по скорингу: самые рискованные вверху
	ТЗ.Сортировать("Скоринг Возр");

	Возврат ТЗ;

КонецФункции

Функция ПустойРезультат()
	Результат = Новый Структура;
	Результат.Вставить("Скоринг",               Неопределено);
	Результат.Вставить("УровеньРиска",           "UNKNOWN");
	Результат.Вставить("МеткаРиска",             "Нет данных");
	Результат.Вставить("ЦветРиска",              "#8E8E93");
	Результат.Вставить("РекомендуемыйЛимит",     0);
	Результат.Вставить("РекомендуемаяОтсрочка",  0);
	Результат.Вставить("РекомендацияТекст",      "");
	Результат.Вставить("Алерты",                 Новый Массив);
	Результат.Вставить("Факторы",                Новый Структура);
	Результат.Вставить("Прогноз",                Новый Структура);
	Результат.Вставить("ИсходныеДанные",         Новый Структура);
	Результат.Вставить("Ошибка",                 "");
	Возврат Результат;
КонецФункции

#КонецОбласти
