// ============================================================
// ДС_АнализДебиторки — Форма обработки (модуль формы)
// ============================================================
// Главный дашборд продукта. Клиент открывает эту форму и видит:
//   — Таблицу всех контрагентов с дебиторкой и скорингом
//   — Цветовую индикацию риска
//   — Рекомендации по каждому
//   — Алерты (просрочки, ухудшение тренда)
//   — Детальный анализ по выбранному контрагенту
// ============================================================

// ── Реквизиты формы (объявляются в конфигураторе) ──────────
// ТаблицаДебиторки       — ТаблицаЗначений (осн. таблица)
// ТекущийКонтрагент      — СправочникСсылка.Контрагенты
// ДатаАнализаС           — Дата
// СкорингТекущего        — Число
// РискТекущего           — Строка
// ЛимитТекущего          — Число
// ОтсрочкаТекущего       — Число
// РекомендацияТекущего   — Строка
// АлертыТекущего         — Строка
// ТрендТекущего          — Строка
// СтатусЛицензии         — Строка

#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура ПриОткрытии(Отказ)
    ДатаАнализаС = ДобавитьМесяц(НачалоМесяца(ТекущаяДата()), -18);
    ПроверитьЛицензию();
КонецПроцедуры

#КонецОбласти

// ── Лицензия ───────────────────────────────────────────────

&НаКлиенте
Процедура ПроверитьЛицензию()
    Результат = ПроверитьЛицензиюНаСервере();
    Если Результат.Действительна Тогда
        СтатусЛицензии = "✅ " + Результат.Тариф + "  •  до " + Результат.ДоКогда;
    Иначе
        СтатусЛицензии = "❌ Лицензия недействительна";
        ПоказатьОповещениеПользователя(
            "Требуется активация",
            ПолучитьНавигационнуюСсылку("ДС_АктивацияЛицензии"),
            "Для работы с DebtScoring необходима активная лицензия.",
            КартинкаСтатусаПроверкиДостоверности.Предупреждение
        );
    КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ПроверитьЛицензиюНаСервере()
    Инфо = ДС_Лицензия.ПолучитьИнформациюОЛицензии();
    Результат = Новый Структура("Действительна,Тариф,ДоКогда", Ложь, "", "");

    Если ТипЗнч(Инфо) = Тип("Структура") И Инфо.Свойство("license_valid") Тогда
        Результат.Действительна = Инфо.license_valid = Истина;
        Если Инфо.Свойство("plan") Тогда
            Результат.Тариф = Инфо.plan;
        КонецЕсли;
    КонецЕсли;
    Возврат Результат;
КонецФункции

// ── Главная кнопка — анализ всей дебиторки ─────────────────

&НаКлиенте
Процедура ЗапуститьАнализ(Команда)
    Если НЕ ДС_Лицензия.ЛицензияДействительна() Тогда
        ПоказатьПредупреждение(, "Для анализа необходима активная лицензия.");
        Возврат;
    КонецЕсли;

    // Показываем индикатор прогресса
    ОчиститьСообщения();
    Состояние("⏳ Анализируем дебиторку... Это займёт 10-30 секунд.");

    ЗапуститьАнализНаСервере(ДатаАнализаС);
    Состояние();

    // Если есть критичные контрагенты — предупреждаем
    КритичныхКоличество = 0;
    Для Каждого Строка Из ТаблицаДебиторки Цикл
        Если Строка.УровеньРиска = "CRITICAL" ИЛИ Строка.УровеньРиска = "HIGH" Тогда
            КритичныхКоличество = КритичныхКоличество + 1;
        КонецЕсли;
    КонецЦикла;

    Если КритичныхКоличество > 0 Тогда
        ПоказатьОповещениеПользователя(
            "Найдены проблемные контрагенты!",
            ,
            "Контрагентов с высоким риском: " + КритичныхКоличество +
            ". Рекомендуется немедленное внимание.",
            КартинкаСтатусаПроверкиДостоверности.Ошибка
        );
    КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ЗапуститьАнализНаСервере(ДатаС)
    ТаблицаРезультатов = ДС_СкоринговыйДвижок.АнализВсейДебиторки(ДатаС);

    // Переносим в реквизит формы
    ТаблицаДебиторки.Очистить();
    Для Каждого Строка Из ТаблицаРезультатов Цикл
        НС = ТаблицаДебиторки.Добавить();
        ЗаполнитьЗначенияСвойств(НС, Строка);
    КонецЦикла;
КонецПроцедуры

// ── Детальный скоринг по выбранному контрагенту ────────────

&НаКлиенте
Процедура ТаблицаДебиторкиВыборСтроки(Элемент, СтрокаФормы, Колонка, СтандартнаяОбработка)
    СтандартнаяОбработка = Ложь;
    Если СтрокаФормы = Неопределено Тогда Возврат; КонецЕсли;

    ТекущийКонтрагент = СтрокаФормы.Контрагент;
    ЗагрузитьДетальныйСкоринг(ТекущийКонтрагент);
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьДетальныйСкоринг(Контрагент)
    Состояние("⏳ Детальный анализ " + Строка(Контрагент) + "...");
    ЗагрузитьДетальныйСкорингНаСервере(Контрагент);
    Состояние();
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьДетальныйСкорингНаСервере(Контрагент)
    Результат = ДС_СкоринговыйДвижок.РассчитатьСкоринг(Контрагент);

    Если ЗначениеЗаполнено(Результат.Ошибка) Тогда
        СообщитьОбОшибке(Результат.Ошибка);
        Возврат;
    КонецЕсли;

    // Заполняем панель детального анализа
    СкорингТекущего      = Результат.Скоринг;
    РискТекущего         = Результат.МеткаРиска;
    ЛимитТекущего        = Результат.РекомендуемыйЛимит;
    ОтсрочкаТекущего     = Результат.РекомендуемаяОтсрочка;
    РекомендацияТекущего = Результат.РекомендацияТекст;
    ТрендТекущего        = "";

    Если Результат.Факторы.Свойство("trend_direction") Тогда
        ТрендТекущего = Результат.Факторы.trend_direction;
    КонецЕсли;

    // Алерты объединяем в одну строку
    Если ТипЗнч(Результат.Алерты) = Тип("Массив") Тогда
        АлертыТекущего = СтрСоединить(Результат.Алерты, Символы.ПС);
    Иначе
        АлертыТекущего = "";
    КонецЕсли;

    // Цвет заголовка скоринга
    УстановитьЦветСкоринга(Результат.ЦветРиска);
КонецПроцедуры

&НаКлиенте
Процедура УстановитьЦветСкоринга(ЦветHEX)
    // Преобразуем HEX → ЦветФонаФормы
    // #FF3B30 → Красный, #007AFF → Синий, и т.д.
    Цвет = ЦветПоHEX(ЦветHEX);
    Элементы.ГруппаСкоринг.ЦветФона = Цвет;
КонецПроцедуры

// ── Условное оформление таблицы (вызывается при выводе) ────

&НаКлиенте
Процедура ТаблицаДебиторкиПриВыводеСтроки(Элемент, ОформлениеСтроки, ДанныеСтроки)
    Риск = ДанныеСтроки.УровеньРиска;

    Если Риск = "CRITICAL" Тогда
        ОформлениеСтроки.ЦветФона = ВебЦвета.МиндальноБелый; // Светло-красный фон
        ОформлениеСтроки.ЦветТекста = ВебЦвета.Красный;
    ИначеЕсли Риск = "HIGH" Тогда
        ОформлениеСтроки.ЦветФона = ВебЦвета.ЛёгкоЖёлтый;
        ОформлениеСтроки.ЦветТекста = ВебЦвета.ТёмноОранжевый;
    ИначеЕсли Риск = "MEDIUM" Тогда
        ОформлениеСтроки.ЦветТекста = ВебЦвета.ТёмноЖёлтый;
    ИначеЕсли Риск = "LOW" Тогда
        ОформлениеСтроки.ЦветТекста = ВебЦвета.Зелёный;
    КонецЕсли;
КонецПроцедуры

// ── Фильтрация таблицы ─────────────────────────────────────

&НаКлиенте
Процедура ПоказатьТолькоПроблемных(Команда)
    ФильтрПроблемных = НЕ ФильтрПроблемных;

    Для Каждого Строка Из ТаблицаДебиторки Цикл
        Если ФильтрПроблемных Тогда
            Строка.Видимость = (Строка.УровеньРиска = "CRITICAL"
                                ИЛИ Строка.УровеньРиска = "HIGH");
        Иначе
            Строка.Видимость = Истина;
        КонецЕсли;
    КонецЦикла;

    Кнопка = ?(ФильтрПроблемных,
        "Показать всех контрагентов",
        "⚠️ Только проблемные");
    Элементы.КнопкаФильтр.Заголовок = Кнопка;
КонецПроцедуры

// ── Экспорт отчёта ─────────────────────────────────────────

&НаКлиенте
Процедура ВыгрузитьВExcel(Команда)
    Если ТаблицаДебиторки.Количество() = 0 Тогда
        ПоказатьПредупреждение(, "Сначала запустите анализ.");
        Возврат;
    КонецЕсли;

    ДиалогВыбораФайла = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
    ДиалогВыбораФайла.Фильтр            = "Таблица Excel (*.xlsx)|*.xlsx";
    ДиалогВыбораФайла.ПолноеИмяФайла    = "Анализ_дебиторки_" +
        Формат(ТекущаяДата(), "ДФ=yyyyMMdd") + ".xlsx";
    ДиалогВыбораФайла.МножественныйВыбор = Ложь;

    Если ДиалогВыбораФайла.Выбрать() Тогда
        ВыгрузитьТаблицуВФайл(ДиалогВыбораФайла.ПолноеИмяФайла);
    КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьТаблицуВФайл(ПутьКФайлу)
    Попытка
        ТабДок = Новый ТабличныйДокумент;

        // Заголовки
        Заголовки = Новый Массив;
        Заголовки.Добавить("Контрагент");
        Заголовки.Добавить("Текущий долг, ₽");
        Заголовки.Добавить("Скоринг");
        Заголовки.Добавить("Уровень риска");
        Заголовки.Добавить("Рек. лимит, ₽");
        Заголовки.Добавить("Рек. отсрочка, дн.");
        Заголовки.Добавить("Рекомендация");
        Заголовки.Добавить("Алерты");

        Для НомерКолонки = 0 По Заголовки.Количество() - 1 Цикл
            Ячейка = ТабДок.Область(1, НомерКолонки + 1);
            Ячейка.Текст = Заголовки[НомерКолонки];
            Ячейка.ЦветФона = ВебЦвета.СтальноСерый;
            Ячейка.ЦветТекста = ВебЦвета.Белый;
            Ячейка.Шрифт = Новый Шрифт(, , Истина);
        КонецЦикла;

        // Данные
        НомерСтроки = 2;
        Для Каждого Строка Из ТаблицаДебиторки Цикл
            ТабДок.Область(НомерСтроки, 1).Текст  = Строка(Строка.Контрагент);
            ТабДок.Область(НомерСтроки, 2).Текст  = Формат(Строка.ТекущийДолг, "ЧГ=0");
            ТабДок.Область(НомерСтроки, 3).Текст  = Формат(Строка.Скоринг, "ЧДЦ=1");
            ТабДок.Область(НомерСтроки, 4).Текст  = Строка.МеткаРиска;
            ТабДок.Область(НомерСтроки, 5).Текст  = Формат(Строка.РекомендуемыйЛимит, "ЧГ=0");
            ТабДок.Область(НомерСтроки, 6).Текст  = Строка.РекомендуемаяОтсрочка;
            ТабДок.Область(НомерСтроки, 7).Текст  = Строка.РекомендацияТекст;
            ТабДок.Область(НомерСтроки, 8).Текст  = Строка.Алерты;
            НомерСтроки = НомерСтроки + 1;
        КонецЦикла;

        ТабДок.Записать(ПутьКФайлу, ТипФайлаТабличногоДокумента.XLSX);
        ПоказатьОповещениеПользователя("Экспорт завершён", "file://" + ПутьКФайлу,
            "Открыть файл?", КартинкаСтатусаПроверкиДостоверности.Успех);
    Исключение
        ПоказатьПредупреждение(, "Ошибка экспорта: " + ОписаниеОшибки());
    КонецПопытки;
КонецПроцедуры

// ── Вспомогательные ────────────────────────────────────────

&НаКлиенте
Функция ЦветПоHEX(ЦветHEX)
    // Упрощённое преобразование для основных цветов риска
    Если ЦветHEX = "#FF3B30" Тогда Возврат ВебЦвета.Красный;
    ИначеЕсли ЦветHEX = "#FF9500" Тогда Возврат ВебЦвета.Оранжевый;
    ИначеЕсли ЦветHEX = "#FFCC00" Тогда Возврат ВебЦвета.Жёлтый;
    ИначеЕсли ЦветHEX = "#34C759" Тогда Возврат ВебЦвета.Зелёный;
    ИначеЕсли ЦветHEX = "#007AFF" Тогда Возврат ВебЦвета.Синий;
    Иначе                               Возврат ВебЦвета.Серый;
    КонецЕсли;
КонецФункции

&НаСервере
Процедура СообщитьОбОшибке(Текст)
    СообщитьПользователю(Текст, , , , СтатусСообщения.Внимание);
КонецПроцедуры
