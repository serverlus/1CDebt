// ============================================================
// Общий модуль: СкорингКонтрагентов
// Версия: 1.0.0
// Назначение: Скоринговая оценка контрагентов по дебиторской задолженности
//
// Категории риска:
//   A (80–100) — Надёжный   (зелёный)
//   B (60–79)  — Умеренный  (жёлтый)
//   C (40–59)  — Высокий    (оранжевый)
//   D (0–39)   — Критичный  (красный)
// ============================================================

#Область ПрограммныйИнтерфейс

// Рассчитать скоринг одного контрагента.
//
// Параметры:
//   Контрагент  - СправочникСсылка.Контрагенты
//   ДатаАнализа - Дата (необязательно, по умолчанию сегодня)
//
// Возвращаемое значение:
//   Структура:
//     * Балл         - Число   (0–100)
//     * Категория    - Строка  (A/B/C/D)
//     * Цвет         - Строка  (для оформления)
//     * Расшифровка  - ТаблицаЗначений (детализация по факторам)
//
Функция РассчитатьСкоринг(Контрагент, ДатаАнализа = Неопределено) Экспорт

	Если ДатаАнализа = Неопределено Тогда
		ДатаАнализа = ТекущаяДата();
	КонецЕсли;

	Результат = НовыйРезультатСкоринга();

	Данные = ПолучитьДанныеДебиторки(Контрагент, ДатаАнализа);

	// 4 независимых фактора, суммарный вес = 100
	РассчитатьФакторДнейПросрочки(Результат, Данные);    // вес 30
	РассчитатьФакторДолиПросрочки(Результат, Данные);    // вес 35
	РассчитатьФакторИсторииПлатежей(Результат, Данные);  // вес 25
	РассчитатьФакторКоличестваПросроченных(Результат, Данные); // вес 10

	Результат.Балл     = Макс(0, Мин(100, Результат.Балл));
	Результат.Категория = ОпределитьКатегорию(Результат.Балл);
	Результат.Цвет      = ЦветКатегории(Результат.Категория);

	Возврат Результат;

КонецФункции

// Получить скоринг по всем контрагентам с активной дебиторкой.
//
// Параметры:
//   ДатаАнализа - Дата (необязательно)
//   ФильтрМенеджер - СправочникСсылка.Пользователи (необязательно)
//
// Возвращаемое значение:
//   ТаблицаЗначений — отсортирована по баллу (сначала проблемные)
//
Функция ПолучитьСкорингВсехКонтрагентов(ДатаАнализа = Неопределено, ФильтрМенеджер = Неопределено) Экспорт

	Если ДатаАнализа = Неопределено Тогда
		ДатаАнализа = ТекущаяДата();
	КонецЕсли;

	ТЗ = СоздатьТаблицуРезультатов();

	Запрос = НовыйЗапросСпискаДолжников(ДатаАнализа, ФильтрМенеджер);
	РезЗапроса = Запрос.Выполнить();

	Если РезЗапроса.Пустой() Тогда
		Возврат ТЗ;
	КонецЕсли;

	Выборка = РезЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл

		Скоринг = РассчитатьСкоринг(Выборка.Контрагент, ДатаАнализа);

		Стр = ТЗ.Добавить();
		Стр.Контрагент             = Выборка.Контрагент;
		Стр.НаименованиеКонтрагента = Выборка.Контрагент.Наименование;
		Стр.ИНН                    = Выборка.Контрагент.ИНН;
		Стр.СуммаДолга             = Выборка.СуммаДолга;
		Стр.СуммаПросрочки         = Выборка.СуммаПросрочки;
		Стр.МаксДнейПросрочки      = Выборка.МаксДнейПросрочки;
		Стр.Балл                   = Скоринг.Балл;
		Стр.Категория              = Скоринг.Категория;
		Стр.Цвет                   = Скоринг.Цвет;
		Стр.ОтветственныйМенеджер  = Выборка.ОтветственныйМенеджер;

	КонецЦикла;

	ТЗ.Сортировать("Балл Возр, СуммаПросрочки Убыв");

	Возврат ТЗ;

КонецФункции

// Получить расшифровку скоринга в виде текста для отображения.
//
// Параметры:
//   СтруктураСкоринга - результат функции РассчитатьСкоринг()
//
// Возвращаемое значение:
//   Строка — многострочный текст с объяснением
//
Функция ПолучитьОписаниеСкоринга(СтруктураСкоринга) Экспорт

	ТекстРезультат = "";

	Для Каждого Строка Из СтруктураСкоринга.Расшифровка Цикл
		ЗнакШтрафа = ?(Строка.Штраф < 0, "", "+");
		ТекстРезультат = ТекстРезультат
			+ "[" + Строка.Фактор + "]  "
			+ Строка.Значение
			+ "  → " + ЗнакШтрафа + Формат(Строка.Штраф, "ЧЦ=4; ЧН=0") + " б."
			+ Символы.ПС;
	КонецЦикла;

	ТекстРезультат = ТекстРезультат
		+ "─────────────────────────────" + Символы.ПС
		+ "Итог: " + СтруктураСкоринга.Балл + " баллов  |  "
		+ "Категория " + СтруктураСкоринга.Категория
		+ " (" + СтруктураСкоринга.Цвет + ")";

	Возврат ТекстРезультат;

КонецФункции

#КонецОбласти

// ============================================================
#Область СлужебныеФункции

Функция НовыйРезультатСкоринга()

	Расшифровка = Новый ТаблицаЗначений;
	Расшифровка.Колонки.Добавить("Фактор",
		Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(100)));
	Расшифровка.Колонки.Добавить("Значение",
		Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(300)));
	Расшифровка.Колонки.Добавить("Штраф",
		Новый ОписаниеТипов("Число", , , Новый КвалификаторыЧисла(5, 0)));
	Расшифровка.Колонки.Добавить("Вес",
		Новый ОписаниеТипов("Число", , , Новый КвалификаторыЧисла(3, 0)));

	Результат = Новый Структура;
	Результат.Вставить("Балл",        100);
	Результат.Вставить("Категория",   "A");
	Результат.Вставить("Цвет",        "Зелёный");
	Результат.Вставить("Расшифровка", Расшифровка);

	Возврат Результат;

КонецФункции

Функция ПолучитьДанныеДебиторки(Контрагент, ДатаАнализа)

	// ── Остатки по взаиморасчётам ──────────────────────────────
	// Адаптируйте имя регистра под свою конфигурацию:
	//   "ВзаиморасчетыСКонтрагентами"  — УТ/КА
	//   "РасчетыСКонтрагентами"        — Бухгалтерия
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СУММА(Ост.СуммаОстаток)             КАК СуммаДолга,
	|	СУММА(ВЫБОР
	|		КОГДА ДОБАВИТЬКДАТЕ(Ост.ДатаОтгрузки, ДЕНЬ, Ост.ДнейОтсрочки) < &ДатаАнализа
	|			ТОГДА Ост.СуммаОстаток
	|		ИНАЧЕ 0
	|	КОНЕЦ)                              КАК СуммаПросрочки,
	|	МАКСИМУМ(ВЫБОР
	|		КОГДА ДОБАВИТЬКДАТЕ(Ост.ДатаОтгрузки, ДЕНЬ, Ост.ДнейОтсрочки) < &ДатаАнализа
	|			ТОГДА РАЗНОСТЬДАТ(ДОБАВИТЬКДАТЕ(Ост.ДатаОтгрузки, ДЕНЬ, Ост.ДнейОтсрочки),
	|				&ДатаАнализа, ДЕНЬ)
	|		ИНАЧЕ 0
	|	КОНЕЦ)                              КАК МаксДнейПросрочки,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВЫБОР
	|		КОГДА ДОБАВИТЬКДАТЕ(Ост.ДатаОтгрузки, ДЕНЬ, Ост.ДнейОтсрочки) < &ДатаАнализа
	|			ТОГДА Ост.Документ
	|		ИНАЧЕ NULL
	|	КОНЕЦ)                              КАК КолПросроченных
	|ИЗ
	|	(ВЫБРАТЬ
	|		ВзОст.СуммаОстаток              КАК СуммаОстаток,
	|		РеалТовУсл.Дата                 КАК ДатаОтгрузки,
	|		ЕСТЬNULL(РеалТовУсл.СрокОплатыПоДоговору, 0) КАК ДнейОтсрочки,
	|		ВзОст.Регистратор               КАК Документ
	|	ИЗ
	|		РегистрНакопления.ВзаиморасчетыСКонтрагентами.Остатки(
	|			&ДатаАнализа,
	|			Контрагент = &Контрагент И СуммаОстаток > 0
	|		) КАК ВзОст
	|			ЛЕВОЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг КАК РеалТовУсл
	|			ПО ВзОст.Регистратор = РеалТовУсл.Ссылка
	|	) КАК Ост";

	Запрос.УстановитьПараметр("Контрагент",  Контрагент);
	Запрос.УстановитьПараметр("ДатаАнализа", КонецДня(ДатаАнализа));

	Данные = Новый Структура(
		"СуммаДолга, СуммаПросрочки, МаксДнейПросрочки, КолПросроченных",
		0, 0, 0, 0);

	РезЗапроса = Запрос.Выполнить();
	Если НЕ РезЗапроса.Пустой() Тогда
		Выб = РезЗапроса.Выбрать();
		Выб.Следующий();
		Данные.СуммаДолга         = ?(Выб.СуммаДолга         = NULL, 0, Выб.СуммаДолга);
		Данные.СуммаПросрочки     = ?(Выб.СуммаПросрочки     = NULL, 0, Выб.СуммаПросрочки);
		Данные.МаксДнейПросрочки  = ?(Выб.МаксДнейПросрочки  = NULL, 0, Выб.МаксДнейПросрочки);
		Данные.КолПросроченных    = ?(Выб.КолПросроченных     = NULL, 0, Выб.КолПросроченных);
	КонецЕсли;

	Данные.Вставить("ИсторияПлатежей",
		ПолучитьИсториюПлатежей(Контрагент, ДатаАнализа));

	Возврат Данные;

КонецФункции

Функция ПолучитьИсториюПлатежей(Контрагент, ДатаАнализа)

	ДатаНачала = ДобавитьМесяц(НачалоДня(ДатаАнализа), -12);

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(ВзОб.Регистратор)       КАК ВсегоДокументов,
	|	СУММА(ВЫБОР
	|		КОГДА ВзОб.Период > ДОБАВИТЬКДАТЕ(РеалТовУсл.Дата, ДЕНЬ,
	|			ЕСТЬNULL(РеалТовУсл.СрокОплатыПоДоговору, 0))
	|			ТОГДА 1
	|		ИНАЧЕ 0
	|	КОНЕЦ)                             КАК КолПросроченных,
	|	СРЕДНЕЕ(ВЫБОР
	|		КОГДА ВзОб.Период > ДОБАВИТЬКДАТЕ(РеалТовУсл.Дата, ДЕНЬ,
	|			ЕСТЬNULL(РеалТовУсл.СрокОплатыПоДоговору, 0))
	|			ТОГДА РАЗНОСТЬДАТ(
	|				ДОБАВИТЬКДАТЕ(РеалТовУсл.Дата, ДЕНЬ,
	|					ЕСТЬNULL(РеалТовУсл.СрокОплатыПоДоговору, 0)),
	|				ВзОб.Период, ДЕНЬ)
	|		ИНАЧЕ NULL
	|	КОНЕЦ)                             КАК СреднееДнейПросрочки
	|ИЗ
	|	РегистрНакопления.ВзаиморасчетыСКонтрагентами.Обороты(
	|		&ДатаНачала, &ДатаАнализа, ,
	|		Контрагент = &Контрагент И СуммаРасход > 0
	|	) КАК ВзОб
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг КАК РеалТовУсл
	|		ПО ВзОб.Регистратор = РеалТовУсл.Ссылка";

	Запрос.УстановитьПараметр("Контрагент",  Контрагент);
	Запрос.УстановитьПараметр("ДатаНачала",  ДатаНачала);
	Запрос.УстановитьПараметр("ДатаАнализа", КонецДня(ДатаАнализа));

	История = Новый Структура(
		"ВсегоДокументов, КолПросроченных, СреднееДнейПросрочки, ПроцентПросроченных",
		0, 0, 0, 0);

	РезЗапроса = Запрос.Выполнить();
	Если НЕ РезЗапроса.Пустой() Тогда
		Выб = РезЗапроса.Выбрать();
		Выб.Следующий();
		История.ВсегоДокументов      = ?(Выб.ВсегоДокументов     = NULL, 0, Выб.ВсегоДокументов);
		История.КолПросроченных      = ?(Выб.КолПросроченных      = NULL, 0, Выб.КолПросроченных);
		История.СреднееДнейПросрочки = ?(Выб.СреднееДнейПросрочки = NULL, 0, Выб.СреднееДнейПросрочки);
		Если История.ВсегоДокументов > 0 Тогда
			История.ПроцентПросроченных =
				История.КолПросроченных / История.ВсегоДокументов * 100;
		КонецЕсли;
	КонецЕсли;

	Возврат История;

КонецФункции

// ── Факторы ──────────────────────────────────────────────────

Процедура РассчитатьФакторДнейПросрочки(Результат, Данные)

	Дней = Данные.МаксДнейПросрочки;
	Штраф = 0;

	Если    Дней > 90  Тогда Штраф = 30;
	ИначеЕсли Дней > 60  Тогда Штраф = 20;
	ИначеЕсли Дней > 30  Тогда Штраф = 12;
	ИначеЕсли Дней > 14  Тогда Штраф = 6;
	ИначеЕсли Дней > 7   Тогда Штраф = 3;
	КонецЕсли;

	Результат.Балл = Результат.Балл - Штраф;

	Стр = Результат.Расшифровка.Добавить();
	Стр.Фактор  = "Макс. просрочка (дней)";
	Стр.Значение = Формат(Дней, "ЧЦ=5; ЧН=0") + " дн.";
	Стр.Штраф   = -Штраф;
	Стр.Вес     = 30;

КонецПроцедуры

Процедура РассчитатьФакторДолиПросрочки(Результат, Данные)

	ДоляПросрочки = 0;
	Если Данные.СуммаДолга > 0 Тогда
		ДоляПросрочки = Данные.СуммаПросрочки / Данные.СуммаДолга * 100;
	КонецЕсли;

	Штраф = 0;
	Если    ДоляПросрочки >= 90 Тогда Штраф = 35;
	ИначеЕсли ДоляПросрочки >= 70 Тогда Штраф = 25;
	ИначеЕсли ДоляПросрочки >= 50 Тогда Штраф = 15;
	ИначеЕсли ДоляПросрочки >= 30 Тогда Штраф = 8;
	ИначеЕсли ДоляПросрочки >= 10 Тогда Штраф = 3;
	КонецЕсли;

	Результат.Балл = Результат.Балл - Штраф;

	Стр = Результат.Расшифровка.Добавить();
	Стр.Фактор  = "Доля просроченного долга";
	Стр.Значение = Формат(ДоляПросрочки, "ЧЦ=5; ЧДЦ=1; ЧН=0") + "%  ("
		+ Формат(Данные.СуммаПросрочки, "ЧЦ=15; ЧГ=3; ЧН=0") + " руб.)";
	Стр.Штраф   = -Штраф;
	Стр.Вес     = 35;

КонецПроцедуры

Процедура РассчитатьФакторИсторииПлатежей(Результат, Данные)

	История = Данные.ИсторияПлатежей;
	Процент  = История.ПроцентПросроченных;

	Штраф = 0;
	Если    Процент >= 50 Тогда Штраф = 25;
	ИначеЕсли Процент >= 30 Тогда Штраф = 15;
	ИначеЕсли Процент >= 15 Тогда Штраф = 8;
	ИначеЕсли Процент >= 5  Тогда Штраф = 3;
	КонецЕсли;

	Результат.Балл = Результат.Балл - Штраф;

	Стр = Результат.Расшифровка.Добавить();
	Стр.Фактор  = "История платежей (12 мес)";
	Стр.Значение = Формат(Процент, "ЧЦ=5; ЧДЦ=1; ЧН=0")
		+ "% просрочено  ("
		+ Формат(История.КолПросроченных,   "ЧЦ=4; ЧН=0")
		+ " из "
		+ Формат(История.ВсегоДокументов, "ЧЦ=4; ЧН=0")
		+ " оплат)";
	Стр.Штраф   = -Штраф;
	Стр.Вес     = 25;

КонецПроцедуры

Процедура РассчитатьФакторКоличестваПросроченных(Результат, Данные)

	Кол = Данные.КолПросроченных;
	Штраф = 0;

	Если    Кол >= 5 Тогда Штраф = 10;
	ИначеЕсли Кол >= 3 Тогда Штраф = 6;
	ИначеЕсли Кол >= 1 Тогда Штраф = 3;
	КонецЕсли;

	Результат.Балл = Результат.Балл - Штраф;

	Стр = Результат.Расшифровка.Добавить();
	Стр.Фактор  = "Кол-во просроченных документов";
	Стр.Значение = Формат(Кол, "ЧЦ=4; ЧН=0") + " шт.";
	Стр.Штраф   = -Штраф;
	Стр.Вес     = 10;

КонецПроцедуры

// ── Утилиты ──────────────────────────────────────────────────

Функция ОпределитьКатегорию(Балл)

	Если    Балл >= 80 Тогда Возврат "A";
	ИначеЕсли Балл >= 60 Тогда Возврат "B";
	ИначеЕсли Балл >= 40 Тогда Возврат "C";
	Иначе                       Возврат "D";
	КонецЕсли;

КонецФункции

Функция ЦветКатегории(Категория)

	Если    Категория = "A" Тогда Возврат "Зелёный";
	ИначеЕсли Категория = "B" Тогда Возврат "Жёлтый";
	ИначеЕсли Категория = "C" Тогда Возврат "Оранжевый";
	Иначе                           Возврат "Красный";
	КонецЕсли;

КонецФункции

Функция СоздатьТаблицуРезультатов()

	ТЗ = Новый ТаблицаЗначений;
	ТЗ.Колонки.Добавить("Контрагент");
	ТЗ.Колонки.Добавить("НаименованиеКонтрагента",
		Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(500)));
	ТЗ.Колонки.Добавить("ИНН",
		Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(12)));
	ТЗ.Колонки.Добавить("СуммаДолга",
		Новый ОписаниеТипов("Число", , , Новый КвалификаторыЧисла(18, 2)));
	ТЗ.Колонки.Добавить("СуммаПросрочки",
		Новый ОписаниеТипов("Число", , , Новый КвалификаторыЧисла(18, 2)));
	ТЗ.Колонки.Добавить("МаксДнейПросрочки",
		Новый ОписаниеТипов("Число", , , Новый КвалификаторыЧисла(5, 0)));
	ТЗ.Колонки.Добавить("Балл",
		Новый ОписаниеТипов("Число", , , Новый КвалификаторыЧисла(3, 0)));
