КонецФункции

Функция НовыйЗапросСпискаДолжников(ДатаАнализа, ФильтрМенеджер)

	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ВзОст.Контрагент                              КАК Контрагент,
	|	СУММА(ВзОст.СуммаОстаток)                    КАК СуммаДолга,
	|	СУММА(ВЫБОР
	|		КОГДА ДОБАВИТЬКДАТЕ(РеалТовУсл.Дата, ДЕНЬ,
	|			ЕСТЬNULL(РеалТовУсл.СрокОплатыПоДоговору, 0)) < &ДатаАнализа
	|			ТОГДА ВзОст.СуммаОстаток
	|		ИНАЧЕ 0
	|	КОНЕЦ)                                        КАК СуммаПросрочки,
	|	МАКСИМУМ(ВЫБОР
	|		КОГДА ДОБАВИТЬКДАТЕ(РеалТовУсл.Дата, ДЕНЬ,
	|			ЕСТЬNULL(РеалТовУсл.СрокОплатыПоДоговору, 0)) < &ДатаАнализа
	|			ТОГДА РАЗНОСТЬДАТ(
	|				ДОБАВИТЬКДАТЕ(РеалТовУсл.Дата, ДЕНЬ,
	|					ЕСТЬNULL(РеалТовУсл.СрокОплатыПоДоговору, 0)),
	|				&ДатаАнализа, ДЕНЬ)
	|		ИНАЧЕ 0
	|	КОНЕЦ)                                        КАК МаксДнейПросрочки,
	|	ЗНАЧЕНИЕ(Справочник.Пользователи.ПустаяСсылка) КАК ОтветственныйМенеджер
	|ИЗ
	|	РегистрНакопления.ВзаиморасчетыСКонтрагентами.Остатки(
	|		&ДатаАнализа,
	|		СуммаОстаток > 0
	|	) КАК ВзОст
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг КАК РеалТовУсл
	|		ПО ВзОст.Регистратор = РеалТовУсл.Ссылка
	|СГРУППИРОВАТЬ ПО
	|	ВзОст.Контрагент
	|ИМЕЮЩИЕ
	|	СУММА(ВзОст.СуммаОстаток) > 0";

	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ДатаАнализа", КонецДня(ДатаАнализа));
	Возврат Запрос;

КонецФункции

