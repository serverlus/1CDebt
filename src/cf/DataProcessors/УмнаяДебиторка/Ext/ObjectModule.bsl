// ============================================================
// Модуль объекта обработки "УмнаяДебиторка"
// Серверная логика: хранит параметры, вызывает скоринг
// ============================================================

#Область ОпределениеТиповДанных

// Возвращает таблицу значений с результатами скоринга.
// Используется формой для первоначальной загрузки.
Функция ПолучитьТаблицуСкоринга(ДатаАнализа, ФильтрМенеджер) Экспорт

	Возврат СкорингКонтрагентов.ПолучитьСкорингВсехКонтрагентов(
		ДатаАнализа,
		ФильтрМенеджер);

КонецФункции

// Возвращает детальную расшифровку по конкретному контрагенту.
Функция ПолучитьРасшифровку(Контрагент, ДатаАнализа) Экспорт

	Скоринг = СкорингКонтрагентов.РассчитатьСкоринг(Контрагент, ДатаАнализа);
	Возврат СкорингКонтрагентов.ПолучитьОписаниеСкоринга(Скоринг);

КонецФункции

#КонецОбласти
