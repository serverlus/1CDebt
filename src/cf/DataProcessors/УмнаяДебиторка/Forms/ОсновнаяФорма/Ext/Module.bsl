// ============================================================
// Модуль формы "ОсновнаяФорма" обработки "УмнаяДебиторка"
// ============================================================

// ── Инициализация ─────────────────────────────────────────────

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// Дата анализа по умолчанию = сегодня
	ДатаАнализа = ТекущаяДата();

	// Первоначальная загрузка скоринга
	ОбновитьТаблицуСкоринга();

КонецПроцедуры

// ── Команды ───────────────────────────────────────────────────

&НаКлиенте
Процедура КомандаОбновить(Команда)
	ОбновитьТаблицуСкоринга();
КонецПроцедуры

&НаКлиенте
Процедура КомандаВыгрузитьExcel(Команда)
	ВыгрузитьВExcelНаСервере();
КонецПроцедуры

// ── Обработчики таблицы ───────────────────────────────────────

&НаКлиенте
Процедура ТаблицаСкорингаПриАктивизацииСтроки(Элемент)
	// При выборе строки — показываем расшифровку справа
	ОбновитьРасшифровкуНаСервере();
КонецПроцедуры

// ── Серверные процедуры ───────────────────────────────────────

&НаСервере
Процедура ОбновитьТаблицуСкоринга()

	РезультатСкоринга = СкорингКонтрагентов.ПолучитьСкорингВсехКонтрагентов(ДатаАнализа);

	// Перегружаем в реквизит формы
	ТаблицаСкоринга.Очистить();

	Для Каждого Строка Из РезультатСкоринга Цикл
		НовСтр = ТаблицаСкоринга.Добавить();
		НовСтр.НаименованиеКонтрагента = Строка.НаименованиеКонтрагента;
		НовСтр.ИНН                     = Строка.ИНН;
		НовСтр.СуммаДолга              = Строка.СуммаДолга;
		НовСтр.СуммаПросрочки          = Строка.СуммаПросрочки;
		НовСтр.МаксДнейПросрочки       = Строка.МаксДнейПросрочки;
		НовСтр.Балл                    = Строка.Балл;
		НовСтр.Категория               = Строка.Категория;

		// Сохраняем ссылку на контрагента для расшифровки
		НовСтр.Контрагент              = Строка.Контрагент;
	КонецЦикла;

	ТекстРасшифровки = "";

	// Подсветка строк по категории риска (делается через условное оформление)
	НастроитьУсловноеОформление();

КонецПроцедуры

&НаСервере
Процедура НастроитьУсловноеОформление()

	УсловноеОформление.Элементы.Очистить();

	// D — Красный
	ЭлОформления = УсловноеОформление.Элементы.Добавить();
	ЭлОформления.Оформление.УстановитьЗначениеПараметра("ЦветФона",
		Новый Цвет(255, 200, 200));
	ОтборЭл = ЭлОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭл.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Категория");
	ОтборЭл.ВидСравнения  = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭл.ПравоеЗначение = "D";
	ЭлОформления.Поля.Элементы.Добавить().Поле =
		Новый ПолеКомпоновкиДанных("НаименованиеКонтрагента");

	// C — Оранжевый
	ЭлОформления = УсловноеОформление.Элементы.Добавить();
	ЭлОформления.Оформление.УстановитьЗначениеПараметра("ЦветФона",
		Новый Цвет(255, 220, 150));
	ОтборЭл = ЭлОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭл.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Категория");
	ОтборЭл.ВидСравнения  = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭл.ПравоеЗначение = "C";
	ЭлОформления.Поля.Элементы.Добавить().Поле =
		Новый ПолеКомпоновкиДанных("НаименованиеКонтрагента");

	// B — Жёлтый
	ЭлОформления = УсловноеОформление.Элементы.Добавить();
	ЭлОформления.Оформление.УстановитьЗначениеПараметра("ЦветФона",
		Новый Цвет(255, 255, 180));
	ОтборЭл = ЭлОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭл.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Категория");
	ОтборЭл.ВидСравнения  = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭл.ПравоеЗначение = "B";
	ЭлОформления.Поля.Элементы.Добавить().Поле =
		Новый ПолеКомпоновкиДанных("НаименованиеКонтрагента");

	// A — Зелёный
	ЭлОформления = УсловноеОформление.Элементы.Добавить();
	ЭлОформления.Оформление.УстановитьЗначениеПараметра("ЦветФона",
		Новый Цвет(200, 255, 200));
	ОтборЭл = ЭлОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭл.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Категория");
	ОтборЭл.ВидСравнения  = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭл.ПравоеЗначение = "A";
	ЭлОформления.Поля.Элементы.Добавить().Поле =
		Новый ПолеКомпоновкиДанных("НаименованиеКонтрагента");

КонецПроцедуры

&НаСервере
Процедура ОбновитьРасшифровкуНаСервере()

	ТекущаяСтрока = Элементы.ТаблицаСкоринга.ТекущиеДанные;
	Если ТекущаяСтрока = Неопределено Тогда
		ТекстРасшифровки = "";
		Возврат;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(ТекущаяСтрока.Контрагент) Тогда
		ТекстРасшифровки = "";
		Возврат;
	КонецЕсли;

	ТекстРасшифровки = Объект.ПолучитьРасшифровку(
		ТекущаяСтрока.Контрагент,
		ДатаАнализа);

КонецПроцедуры

&НаСервере
Процедура ВыгрузитьВExcelНаСервере()

	// Выгрузка в табличный документ → Excel
	ТабДок = Новый ТабличныйДокумент;

	// Шапка
	ТабДок.Область("R1C1").Текст = "Умная дебиторка — Скоринг контрагентов";
	ТабДок.Область("R1C1").Шрифт = Новый Шрифт(, 14, Истина);
	ТабДок.Область("R2C1").Текст = "Дата анализа: " + Формат(ДатаАнализа, "ДФ=dd.MM.yyyy");

	СтрокаЗаголовков = 4;
	Заголовки = Новый Массив;
	Заголовки.Добавить("Контрагент");
	Заголовки.Добавить("ИНН");
	Заголовки.Добавить("Долг, руб.");
	Заголовки.Добавить("Просрочка, руб.");
	Заголовки.Добавить("Макс. дней");
	Заголовки.Добавить("Балл");
	Заголовки.Добавить("Категория");

	Для НомерКол = 1 По Заголовки.Количество() Цикл
		Обл = ТабДок.Область(СтрокаЗаголовков, НомерКол);
		Обл.Текст = Заголовки[НомерКол - 1];
		Обл.Шрифт = Новый Шрифт(, , Истина);
		Обл.ЦветФона = Новый Цвет(200, 200, 200);
	КонецЦикла;

	НомерСтроки = СтрокаЗаголовков + 1;
	Для Каждого Строка Из ТаблицаСкоринга Цикл
		ТабДок.Область(НомерСтроки, 1).Текст = Строка.НаименованиеКонтрагента;
		ТабДок.Область(НомерСтроки, 2).Текст = Строка.ИНН;
		ТабДок.Область(НомерСтроки, 3).Текст = Строка.СуммаДолга;
		ТабДок.Область(НомерСтроки, 4).Текст = Строка.СуммаПросрочки;
		ТабДок.Область(НомерСтроки, 5).Текст = Строка.МаксДнейПросрочки;
		ТабДок.Область(НомерСтроки, 6).Текст = Строка.Балл;
		ТабДок.Область(НомерСтроки, 7).Текст = Строка.Категория;

		// Цветовая индикация
		ЦветФона = ЦветФонаПоКатегории(Строка.Категория);
		ТабДок.Область(НомерСтроки, 6).ЦветФона = ЦветФона;
		ТабДок.Область(НомерСтроки, 7).ЦветФона = ЦветФона;

		НомерСтроки = НомерСтроки + 1;
	КонецЦикла;

	ТабДок.Показать("Умная дебиторка");

КонецПроцедуры

Функция ЦветФонаПоКатегории(Категория)
	Если    Категория = "A" Тогда Возврат Новый Цвет(200, 255, 200);
	ИначеЕсли Категория = "B" Тогда Возврат Новый Цвет(255, 255, 180);
	ИначеЕсли Категория = "C" Тогда Возврат Новый Цвет(255, 220, 150);
	Иначе                           Возврат Новый Цвет(255, 200, 200);
	КонецЕсли;
КонецФункции
